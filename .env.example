# DB 연결
# 로컬 개발 : SSH 터널 경유 (npm run ssh 를 켠 상태에서 localhost:5433)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/panda?schema=public"
# EC2 배포: RDS 엔드포인트에 직접 연결 (터널 불필요)
# DATABASE_URL="postgresql://USER:PASSWORD@[RDS엔드포인트]:5432/panda?schema=public"

# 서버
PORT=4000

# CORS 허용 origin (프론트 주소)
CLIENT_URL="http://localhost:3000"

# JWT
JWT_SECRET="여기에_긴_랜덤_문자열"
JWT_ACCESS_EXPIRES="1h"
JWT_REFRESH_EXPIRES="2w"

# 실행 환경 (development | production)
NODE_ENV=development

# --- AWS ---
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PUBLIC_BUCKET_NAME=
AWS_PRIVATE_BUCKET_NAME=

# --- 로컬에서 RDS 접속용 SSH 터널링 ---
# EC2 안에서 실행할 땐 필요 없음 (RDS에 직접 접근)
SSH_KEY_PATH=~/.ssh/[프라이빗키_이름].pem
EC2_HOST=[EC2_퍼블릭_IP]
EC2_USER=ec2-user
DB_HOST=[rds-db-instance-엔드포인트]